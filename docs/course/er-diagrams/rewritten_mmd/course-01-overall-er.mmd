flowchart LR
    %% UniBot 总体 ER 图（Chen 风格）：矩形=实体，菱形=联系，椭圆=主要属性

    IM["IM_ACCOUNT<br/>账号"]
    BOT["BOT<br/>机器人"]
    CG["CHAT_GROUP<br/>群组"]
    UG["USER_GROUP<br/>账号群关系"]
    CV["CONVERSATION<br/>会话"]
    MSG["MESSAGE<br/>消息"]
    DS["DEBUG_SESSION<br/>调试会话"]
    PP["PROTOCOL_PACKET<br/>协议包"]
    AE["AUDIT_EVENT<br/>审计事件"]

    IM_UID(["user_id PK"])
    IM_SRC(["account_source"])
    BOT_ID(["bot_id PK"])
    CG_ID(["group_id PK"])
    CV_ID(["conversation_id PK"])
    MSG_ID(["message_id PK"])
    PP_ID(["packet_id PK"])

    IM --- IM_UID
    IM --- IM_SRC
    BOT --- BOT_ID
    CG --- CG_ID
    CV --- CV_ID
    MSG --- MSG_ID
    PP --- PP_ID

    R_BIND{"绑定"}
    R_OWN_CV{"拥有"}
    R_VIEW{"拥有群视图"}
    R_SEND{"发送"}
    R_ACT{"执行"}
    R_START{"启动"}
    R_INTERACT{"协议交互"}
    R_GROUP{"归入"}
    R_APPEAR{"出现在"}
    R_PEER{"作为会话对象"}
    R_HOST{"承载"}
    R_DISPLAY{"展示"}

    IM ---|"1"| R_BIND ---|"0..1"| BOT
    IM ---|"1"| R_OWN_CV ---|"N"| CV
    IM ---|"1"| R_VIEW ---|"N"| UG
    IM ---|"1"| R_SEND ---|"N"| MSG
    IM ---|"1"| R_ACT ---|"N"| AE
    BOT ---|"1"| R_START ---|"N"| DS
    BOT ---|"1"| R_INTERACT ---|"N"| PP
    DS ---|"1"| R_GROUP ---|"N"| PP
    CG ---|"1"| R_APPEAR ---|"N"| UG
    CG ---|"1"| R_PEER ---|"N"| CV
    CG ---|"1"| R_HOST ---|"N"| MSG
    CV ---|"1"| R_DISPLAY ---|"N"| MSG

    classDef entity fill:#ffffff,stroke:#1677ff,stroke-width:2px,color:#000000;
    classDef relation fill:#ffffff,stroke:#1677ff,stroke-width:2px,color:#000000;
    classDef attr fill:#ffffff,stroke:#1677ff,stroke-width:2px,color:#000000;
    class IM,BOT,CG,UG,CV,MSG,DS,PP,AE entity;
    class R_BIND,R_OWN_CV,R_VIEW,R_SEND,R_ACT,R_START,R_INTERACT,R_GROUP,R_APPEAR,R_PEER,R_HOST,R_DISPLAY relation;
    class IM_UID,IM_SRC,BOT_ID,CG_ID,CV_ID,MSG_ID,PP_ID attr;
